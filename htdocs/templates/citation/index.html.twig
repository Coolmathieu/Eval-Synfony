{% extends 'base.html.twig' %}

{% block title %}Liste des Citations{% endblock %}

{% block body %}
    <h1>Liste des Citations</h1>

    <a href="{{ path('app_citation_new') }}">Ajouter une citation</a>

    <ul>
        {% for citation in citations %}
            <li>
                <strong>« {{ citation.texte }} »</strong> — <em>{{ citation.auteur }}</em>

                {% if citation.genre %}
                    <small> - {{ citation.genre.value }}</small>
                {% endif %}
                {% if citation.type %}
                    <small>({{ citation.type }})</small>
                {% endif %}

                {% if citation.source %}
                    <small>{{ citation.source }}</small>
                {% endif %}

                {% if citation.dateCitation %}
                    <small>Citattion datant du {{ citation.dateCitation|date('d/m/Y') }}</small>
                {% endif %}

                {% if citation.dateAjout %}
                    <small>ajouté le : ({{ citation.dateAjout|date('d/m/Y') }})</small>
                {% endif %}
            </li>
        {% else %}
            <li>Aucune citation disponible pour l'instant</li>
        {% endfor %}
    </ul>
{% endblock %}
