{% extends 'base.html.twig' %}

{% block title %}Ajouter une citation{% endblock %}

{% block body %}
    <a href="{{ path('app_citation_index') }}">&larr; Retour aux citations</a>
    <h1>Ajouter une citation</h1>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_row(form.texte) }}
    {{ form_row(form.auteur) }}
    {{ form_row(form.genre) }}
    {{ form_row(form.source) }}
    {{ form_row(form.dateCitation) }}
    {{ form_row(form.type) }}
    <button type="submit">Enregistrer</button>
    {{ form_end(form) }}
{% endblock %}
