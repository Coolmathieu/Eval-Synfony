{% extends 'base.html.twig' %}

{% block title %}Voir la Citations{% endblock %}

{% block body %}
    <h1>Voir la Citations</h1>

    <a href="{{ path('app_citation_index') }}">Retour à la liste de citation</a>

    <ul>
            <li>
                <strong>« {{ citation.texte }} »</strong> — <em>{{ citation.auteur }}</em>

                {% if citation.genre %}
                    <small> - {{ citation.genre.value }}</small>
                {% endif %}
                {% if citation.type %}
                    <small>({{ citation.type }})</small>
                {% endif %}

                {% if citation.source %}
                    <small>{{ citation.source }}</small>
                {% endif %}

                {% if citation.dateCitation %}
                    <small>Citattion datant du {{ citation.dateCitation|date('d/m/Y') }}</small>
                {% endif %}

                {% if citation.dateAjout %}
                    <small>ajouté le : ({{ citation.dateAjout|date('d/m/Y') }})</small>
                {% endif %}
                <a href="{{ path('app_citation_edit', {'id': citation.id}) }}">Modifier</a>
                <a href="{{ path('app_citation_delete', {'id': citation.id}) }}">Supprimer</a>

            </li>
    </ul>
{% endblock %}
